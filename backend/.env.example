# Copy to .env and fill in real values. Never commit the real .env.

# Postgres connection string used by the API, worker, and Alembic.
# Matches docker/docker-compose.yml's `db` service for local dev.
DATABASE_URL=postgresql+asyncpg://parking:parking@localhost:5434/parking

# YOLOv8 weights file (local path — a bare name triggers an Ultralytics
# network download instead). Default is yolov8n-obb.pt: the DOTA-pretrained
# oriented-bbox checkpoint. The stock COCO yolov8n.pt scores ~18% on
# top-down/aerial footage (COCO has no overhead vehicle imagery); the
# DOTA checkpoint is aerial-native and has small/large-vehicle classes.
# See docs/evaluation.md.
YOLO_WEIGHTS_PATH=../models/yolov8n-obb.pt
# Minimum detection confidence kept before vehicle-class filtering.
YOLO_CONF_THRESHOLD=0.25
# Inference image size. 1024 for the aerial checkpoint (640, YOLO's default,
# is too small for cars in 1920px-wide top-down footage). Use 640 if you
# switch YOLO_WEIGHTS_PATH back to a stock COCO checkpoint.
YOLO_IMGSZ=1024

# Default matching strategy (CentroidCoverageStrategy): minimum fraction of
# a detected vehicle box that must fall inside a spot polygon for the spot
# to count as occupied.
OCCUPANCY_COVERAGE_THRESHOLD=0.5
# CentroidIoUStrategy's bbox-IoU threshold — only used if you swap back to
# that strategy.
OCCUPANCY_IOU_THRESHOLD=0.3
# OccupancySmoother's majority-vote window size, in samples (default: 5).
SMOOTHING_WINDOW=5

# Batch-scheduler tick rate (ticks/sec) — NOT a per-camera rate; each
# camera paces its own grabs from its own `cameras.sample_fps` DB column.
# Should be >= the fastest camera's rate. Default: 1 frame every 1-2s, so
# 1.0 here matches a 1s-cadence camera.
SAMPLE_FPS=1.0

# Camera source URIs (video paths or RTSP URLs) live in the `cameras` table,
# not here — see scripts/annotate_spots.py.

# docker/docker-compose.yml reads this same file for the api/worker services
# but overrides DATABASE_URL (in-network host, not this host-mapped port)
# and YOLO_WEIGHTS_PATH (the container's /models mount) itself — no edits
# needed here just to run `docker compose up`.
